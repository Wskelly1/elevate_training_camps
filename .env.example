# Sanity CMS (required)
# Find these at https://www.sanity.io/manage under your project
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"

# SendGrid (required for contact form + newsletter emails)
# Create an API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM_EMAIL="your_verified_sender@yourdomain.com"
SENDGRID_TO_EMAIL="where_contact_form_submissions_should_arrive@yourdomain.com"

# HubSpot (required for contact form + newsletter lead capture)
# Create a private app at https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN="your_hubspot_private_app_token"

# Site URL (used to build absolute links in emails and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
