# Sanity CMS (required)
# Find these at https://www.sanity.io/manage under your project
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"

# Gmail / Google Workspace (required for contact form + newsletter emails)
# GMAIL_USER is the real account you generate the App Password on
# (requires 2-Step Verification): https://myaccount.google.com/apppasswords
# GMAIL_FROM_EMAIL can be a verified "Send mail as" alias of that account
# (Gmail Settings > Accounts and Import > Send mail as) instead of the login itself
GMAIL_USER="your_workspace_account@yourdomain.com"
GMAIL_APP_PASSWORD="your_16_character_app_password"
GMAIL_FROM_EMAIL="your_display_from_address@yourdomain.com"
GMAIL_TO_EMAIL="where_contact_form_submissions_should_arrive@yourdomain.com"

# CRM — the in-house lead store at /crm (docs/13-crm-setup.md)
# Replaced HubSpot on 2026-08-11. Contact-form and newsletter submissions are
# filed here automatically; the newsletter's recipient list is read from it.
#
# Neon Postgres, free tier. Provision it in the Vercel dashboard
# (Storage > Create Database > Neon) — Vercel then sets DATABASE_URL itself.
# Create the tables with: npm run crm:migrate
DATABASE_URL=

# Sign-in for /crm: Google Workspace SSO, allowlisted by email.
# No password is stored by this app. The OAuth client must be configured as an
# "Internal" app so Google refuses anyone outside the Workspace domain.
# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated. An empty list denies everyone — deliberately.
CRM_ALLOWED_EMAILS="you@yourdomain.com"

# Site URL (used to build absolute links in emails and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Google Analytics (optional — omit to disable tracking entirely)
# Create a GA4 property at https://analytics.google.com and use its Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Newsletter sending (docs/04-email-setup.md)
NEWSLETTER_SEND_SECRET=choose-a-long-random-string
# Optional: lets /api/newsletter/send stamp sentAt on sent issues
SANITY_API_WRITE_TOKEN=
